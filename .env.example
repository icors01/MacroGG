# Environment variables template
# Copy this file to .env.local and fill in your actual values

# Firebase Configuration (VITE_ = visible in browser - acceptable)
VITE_FIREBASE_API_KEY=your_key
VITE_FIREBASE_AUTH_DOMAIN=your_domain
VITE_FIREBASE_PROJECT_ID=your_project
VITE_FIREBASE_STORAGE_BUCKET=your_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Gemini API (Server-side only - NO VITE_ prefix!)
# This is hidden from the frontend and only used in /api routes
GEMINI_API_KEY=your_gemini_key
GEMINI_MODEL=gemini-2.5-flash

# EmailJS Configuration (Server-side only - NO VITE_ prefix!)
# These are hidden from the frontend and only used in /api routes
EMAILJS_SERVICE_ID=your_service_id
EMAILJS_TEMPLATE_ID=your_template_id
EMAILJS_PUBLIC_KEY=your_public_key
